# OpenRouter: Jev (typesafe/jev-1.13) labels turns in the core CLI, the eval and the extension.
# `npm run build -w extension` bakes this key into extension/dist, so never share a build made with a real key.
OPENROUTER_API_KEY=
# UF Navigator (OpenAI-compatible): generates the eval dataset only.
NAVIGATOR_API_KEY=
# Feature 8: spoken nudges (build time only, see extension/scripts/generate-voice.mjs)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Sync API storage: your Atlas connection string (Atlas → Connect → Drivers). Never commit the real one.
MONGODB_URI=
MONGODB_DB=bridge
