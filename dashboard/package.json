{
  "name": "@bridge/dashboard",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "gen:api": "cd .. && uv run --group api python -c 'import json; from api.main import app; print(json.dumps(app.openapi(), indent=2))' > api/openapi.json && cd dashboard && openapi-typescript ../api/openapi.json -o src/api-schema.d.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@mantine/charts": "^8.3.18",
    "@mantine/core": "^8.3.18",
    "@mantine/hooks": "^8.3.18",
    "@tabler/icons-react": "^3.48.0",
    "@tanstack/react-query": "^5.104.0",
    "date-fns": "^4.4.0",
    "openapi-fetch": "^0.17.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  }
}
