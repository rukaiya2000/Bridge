{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dashboard",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "dashboard"
      ],
      "port": 5173
    },
    {
      "name": "api",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--group",
        "api",
        "uvicorn",
        "api.main:app",
        "--reload"
      ],
      "port": 8000
    }
  ]
}
